generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  password           String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  role               UserRole         @default(STAFF)
  staffId            String?          @unique
  hashedRefreshToken String?
  approvedVouchers   PaymentVoucher[] @relation("ApprovedVouchers")
  initiatedVouchers  PaymentVoucher[] @relation("InitiatedVouchers")
  verifiedVouchers   PaymentVoucher[] @relation("VerifiedVouchers")
  staff              Staff?           @relation("UserStaff", fields: [staffId], references: [id])

  sentMemos Memo[] @relation("SentMemos")
   sentCirculars Circular[] @relation("SentCirculars")
   createdMaintenances Maintenance[] @relation("CreatedMaintenances")
    createdBudgets Budget[] @relation("CreatedBudgets")
      createdInventoryItems InventoryItem[] @relation("CreatedInventoryItems")
}

model Staff {
  id                    String               @id @default(uuid())
  staffId               String               @unique
  firstName             String
  lastName              String
  phone                 String?
  email                 String?
  officialEmail         String?
  gender                Gender?
  profileImage          String?
  role                  UserRole             @default(STAFF)
  designation           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  payrollItems          PayrollItem[]
  payslips              Payslip[]
  requestedProcurements ProcurementRequest[] @relation("RequestedProcurements")
  assignedProcurements  ProcurementRequest[] @relation("AssignedProcurements")
  salaryDefinition      SalaryDefinition?
  user                  User?                @relation("UserStaff")

  receivedMemos Memo[] @relation("ReceivedMemos")

    requestedLogistics LogisticsRequest[] @relation("RequestedLogistics")
  assignedLogistics  LogisticsRequest[] @relation("AssignedLogistics")
}

model SalaryDefinition {
  id                     String   @id @default(uuid())
  staffId                String   @unique
  basicSalary            Decimal  @db.Decimal(12, 2)
  housingAllowance       Decimal  @default(0) @db.Decimal(12, 2)
  transportAllowance     Decimal  @default(0) @db.Decimal(12, 2)
  utilityAllowance       Decimal  @default(0) @db.Decimal(12, 2)
  productivityAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  communicationAllowance Decimal  @default(0) @db.Decimal(12, 2)
  inconvenienceAllowance Decimal  @default(0) @db.Decimal(12, 2)
  deductions             Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary            Decimal  @db.Decimal(12, 2)
  netSalary              Decimal  @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  pension                Decimal  @default(0) @db.Decimal(12, 2)
  tax                    Decimal  @default(0) @db.Decimal(12, 2)
  staff                  Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model TaxDefinition {
  id         String   @id @default(uuid())
  taxType    String
  percentage Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PayrollRun {
  id          String        @id @default(uuid())
  paymentName String
  designation String?
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)

  items PayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollItem {
  id                     String     @id @default(uuid())
  payrollRunId           String
  staffId                String
  basicSalary            Decimal    @db.Decimal(12, 2)
  housingAllowance       Decimal    @default(0) @db.Decimal(12, 2)
  transportAllowance     Decimal    @default(0) @db.Decimal(12, 2)
  utilityAllowance       Decimal    @default(0) @db.Decimal(12, 2)
  productivityAllowance  Decimal    @default(0) @db.Decimal(12, 2)
  communicationAllowance Decimal    @default(0) @db.Decimal(12, 2)
  inconvenienceAllowance Decimal    @default(0) @db.Decimal(12, 2)
  grossSalary            Decimal    @db.Decimal(12, 2)
  tax                    Decimal    @default(0) @db.Decimal(12, 2)
  pension                Decimal    @default(0) @db.Decimal(12, 2)
  deductions             Decimal    @default(0) @db.Decimal(12, 2)
  netSalary              Decimal    @db.Decimal(12, 2)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  payrollRun             PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff                  Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Payslip {
  id                     String   @id @default(uuid())
  staffId                String
  month                  Int
  year                   Int
  basicSalary            Decimal  @db.Decimal(12, 2)
  housingAllowance       Decimal  @default(0) @db.Decimal(12, 2)
  transportAllowance     Decimal  @default(0) @db.Decimal(12, 2)
  utilityAllowance       Decimal  @default(0) @db.Decimal(12, 2)
  productivityAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  communicationAllowance Decimal  @default(0) @db.Decimal(12, 2)
  inconvenienceAllowance Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary            Decimal  @db.Decimal(12, 2)
  tax                    Decimal  @default(0) @db.Decimal(12, 2)
  pension                Decimal  @default(0) @db.Decimal(12, 2)
  totalDeduction         Decimal  @default(0) @db.Decimal(12, 2)
  netSalary              Decimal  @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  deductions             Decimal  @default(0) @db.Decimal(12, 2)
  staff                  Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
}

model ProcurementRequest {
  id             String          @id @default(uuid())
  sn             String          @unique
  item           String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  totalPrice     Decimal         @db.Decimal(12, 2)
  status         RequestStatus   @default(PENDING)
  hasAttachment  Boolean         @default(false)
  attachmentType AttachmentType?
  attachmentUrl  String?
  requestedById  String
  sentToId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  paymentVoucher PaymentVoucher?
  requestedBy    Staff           @relation("RequestedProcurements", fields: [requestedById], references: [id])
  sentTo         Staff           @relation("AssignedProcurements", fields: [sentToId], references: [id])
}

model PaymentVoucher {
  id            String             @id @default(uuid())
  procurementId String             @unique
  vatPercentage Decimal            @default(7.50) @db.Decimal(5, 2)
  vatAmount     Decimal            @db.Decimal(12, 2)
  grossAmount   Decimal            @db.Decimal(12, 2)
  initiatedById String
  verifiedById  String?
  approvedById  String?
  remarks       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  status        VoucherStatus      @default(PENDING)
  beneficiary   BeneficiaryDetail?
  approvedBy    User?              @relation("ApprovedVouchers", fields: [approvedById], references: [id])
  initiatedBy   User               @relation("InitiatedVouchers", fields: [initiatedById], references: [id])
  procurement   ProcurementRequest @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  verifiedBy    User?              @relation("VerifiedVouchers", fields: [verifiedById], references: [id])
}

model BeneficiaryDetail {
  id               String         @id @default(uuid())
  paymentVoucherId String         @unique
  accountName      String
  accountNumber    String
  bankName         String
  paymentVoucher   PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
}

model Memo {
  id             String   @id @default(uuid())
  title          String
  message        String
  senderId       String
  sender         User     @relation("SentMemos", fields: [senderId], references: [id])
  receiverId     String
  receiver       Staff    @relation("ReceivedMemos", fields: [receiverId], references: [id])
  hasAttachment  Boolean  @default(false)
  attachmentType String?
  attachmentUrl  String?
  action         String?
  remarks        String?
  status         String?  @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum MemoStatus {
  SENT
  READ
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  HR
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttachmentType {
  INVOICE
  RECEIPT
}

enum VoucherStatus {
  PENDING
  VERIFIED
  APPROVED
  PAID
  REJECTED
}

model Circular {
  id        String   @id @default(uuid())
  title     String
  message   String
  sentToGroup String
  senderId  String
  sender    User     @relation("SentCirculars", fields: [senderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maintenance {
  id               String            @id @default(uuid())
  itemName         String
  quantity         Int
  scheduledDate    DateTime
  maintenanceType  MaintenanceType
  recurringOption  String?
  status           MaintenanceStatus @default(PENDING)
  attachmentUrl    String?
  createdById      String
  createdBy        User              @relation("CreatedMaintenances", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum MaintenanceType {
  RECURRING
  ONE_TIME
}

enum MaintenanceStatus {
  PENDING
  COMPLETED
  OVERDUE
}

model LogisticsRequest {
  id            String                @id @default(uuid())
  title         String
  purpose       String
  amount        Decimal               @db.Decimal(12, 2)
  dateFrom      DateTime
  dateTo        DateTime
  status        RequestStatus         @default(PENDING)
  requestedById String
  sentToId      String
  requestedBy   Staff                 @relation("RequestedLogistics", fields: [requestedById], references: [id])
  sentTo        Staff                 @relation("AssignedLogistics", fields: [sentToId], references: [id])
  beneficiary   LogisticsBeneficiary?
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model LogisticsBeneficiary {
  id                 String           @id @default(uuid())
  logisticsRequestId String           @unique
  accountName        String
  accountNumber      String
  bankName           String
  logisticsRequest   LogisticsRequest @relation(fields: [logisticsRequestId], references: [id], onDelete: Cascade)
}

model Budget {
  id                String       @id @default(uuid())
  budgetNo          String       @unique
  description       String
  budgetedAmount    Decimal      @db.Decimal(14, 2)
  actualAmount      Decimal?     @db.Decimal(14, 2)
  receivingOffice   String?
  status            BudgetStatus @default(PENDING)
  createdById       String
  createdBy         User         @relation("CreatedBudgets", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

model InventoryItem {
  id              String        @id @default(uuid())
  type            InventoryType
  productName     String
  productId       String
  category        String
  qtyPurchased    Int
  unitPrice       Decimal       @db.Decimal(14, 2)
  supplier        String
  imageUrl        String?

  
  quantityInStock Int?

 
  totalUnits      Int?
  functioningUnits Int?

  createdById     String
  createdBy       User          @relation("CreatedInventoryItems", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum InventoryType {
  STOCK
  INVENTORY
}